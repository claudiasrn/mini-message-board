<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Messageboard</title>
</head>
<body>
    <h1>Mini Messageboard</h1>
    <a href="/new">Add a new message</a>
    <ul>
        <% messages.forEach((message, index) => { %>
            <li>
                <p><%= message.text %></p>
                <p><%= message.user %></p>
                <p><%= message.added %></p>
                <a href= "/message/<%= index %>">Open</a>
            </li>
        <% }); %>
    </ul>
</body>
</html>